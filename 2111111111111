using System;
using System.Collections.Generic;
using System.Management;
using System.Net.NetworkInformation;
using System.Windows;
using System.Windows.Controls;
using Microsoft.Win32;

namespace LabWork21
{
    public partial class MainWindow : Window
    {
        public MainWindow()
        {
            InitializeComponent();
            Title = "Системный монитор - Лабораторная работа №21";
            Width = 1200;
            Height = 800;
            WindowState = WindowState.Maximized;

            // Создаём TabControl
            TabControl tabControl = new TabControl();
            tabControl.Margin = new Thickness(10);

            // Добавляем все вкладки
            tabControl.Items.Add(CreateHardwareTab("Процессор", "Win32_Processor"));
            tabControl.Items.Add(CreateHardwareTab("Видеокарта", "Win32_VideoController"));
            tabControl.Items.Add(CreateHardwareTab("Материнская плата", "Win32_MotherboardDevice"));
            tabControl.Items.Add(CreateHardwareTab("Физические диски", "Win32_DiskDrive"));
            tabControl.Items.Add(CreateHardwareTab("Операционная система", "Win32_OperatingSystem"));

            tabControl.Items.Add(CreateNetworkTab());
            tabControl.Items.Add(CreateInstalledProgramsTab());

            // Помещаем TabControl в основное окно
            Content = tabControl;
        }

        // Универсальная вкладка для WMI (Процессор, Видеокарта, Диски и т.д.)
        private TabItem CreateHardwareTab(string title, string wmiClass)
        {
            TabItem tab = new TabItem { Header = title };

            DataGrid dgv = new DataGrid
            {
                AutoGenerateColumns = true,
                IsReadOnly = true,
                Margin = new Thickness(5),
                AlternatingRowBackground = System.Windows.Media.Brushes.LightGray
            };

            try
            {
                ManagementObjectSearcher searcher = new ManagementObjectSearcher($"SELECT * FROM {wmiClass}");
                ManagementObjectCollection collection = searcher.Get();

                var items = new List<Dictionary<string, object>>();

                foreach (ManagementObject obj in collection)
                {
                    var dict = new Dictionary<string, object>();
                    foreach (PropertyData prop in obj.Properties)
                    {
                        if (prop.Value != null)
                            dict[prop.Name] = prop.Value;
                    }
                    if (dict.Count > 0)
                        items.Add(dict);
                }

                dgv.ItemsSource = items;

                if (items.Count == 0)
                {
                    dgv.ItemsSource = new[] { new { Информация = "Нет данных или доступ ограничен политикой колледжа" } };
                }
            }
            catch (Exception ex)
            {
                dgv.ItemsSource = new[] { new { Ошибка = ex.Message } };
            }

            tab.Content = dgv;
            return tab;
        }

        // Вкладка "Сеть"
        private TabItem CreateNetworkTab()
        {
            TabItem tab = new TabItem { Header = "Сеть" };

            TextBox textBox = new TextBox
            {
                IsReadOnly = true,
                TextWrapping = TextWrapping.Wrap,
                VerticalScrollBarVisibility = ScrollBarVisibility.Auto,
                Margin = new Thickness(10),
                FontFamily = new System.Windows.Media.FontFamily("Consolas"),
                FontSize = 12
            };

            try
            {
                var adapters = NetworkInterface.GetAllNetworkInterfaces();
                string info = "Найдено сетевых интерфейсов: " + adapters.Length + "\n\n";

                foreach (var adapter in adapters)
                {
                    info += $"● {adapter.Name}\n";
                    info += $"   Описание: {adapter.Description}\n";
                    info += $"   Тип: {adapter.NetworkInterfaceType}\n";
                    info += $"   Статус: {adapter.OperationalStatus}\n";
                    info += $"   Скорость: {adapter.Speed / 1_000_000} Мбит/с\n";
                    info += $"   MAC-адрес: {adapter.GetPhysicalAddress()}\n";

                    var ipProps = adapter.GetIPProperties();
                    foreach (var addr in ipProps.UnicastAddresses)
                    {
                        if (addr.Address.AddressFamily == System.Net.Sockets.AddressFamily.InterNetwork)
                            info += $"   IPv4: {addr.Address}\n";
                    }
                    info += "────────────────────────────────────\n\n";
                }

                textBox.Text = info;
            }
            catch (Exception ex)
            {
                textBox.Text = "Ошибка получения информации о сети:\n" + ex.Message;
            }

            tab.Content = textBox;
            return tab;
        }

        // Вкладка "Установленные программы"
        private TabItem CreateInstalledProgramsTab()
        {
            TabItem tab = new TabItem { Header = "Установленные программы" };

            ListView listView = new ListView
            {
                Margin = new Thickness(10)
            };

            GridView gridView = new GridView();
            gridView.Columns.Add(new GridViewColumn 
            { 
                Header = "Название установленной программы", 
                Width = 800,
                DisplayMemberBinding = new System.Windows.Data.Binding(".")
            });
            listView.View = gridView;

            try
            {
                var programs = new SortedSet<string>();

                // HKEY_CURRENT_USER
                ReadUninstallKeys(Registry.CurrentUser, @"Software\Microsoft\Windows\CurrentVersion\Uninstall", programs);

                // HKEY_LOCAL_MACHINE (64-bit)
                ReadUninstallKeys(Registry.LocalMachine, @"SOFTWARE\Microsoft\Windows\CurrentVersion\Uninstall", programs);

                // HKEY_LOCAL_MACHINE (32-bit на 64-bit системе)
                ReadUninstallKeys(Registry.LocalMachine, @"SOFTWARE\WOW6432Node\Microsoft\Windows\CurrentVersion\Uninstall", programs);

                foreach (var prog in programs)
                {
                    if (!string.IsNullOrWhiteSpace(prog))
                        listView.Items.Add(prog);
                }

                if (listView.Items.Count == 0)
                    listView.Items.Add("Программы не найдены (возможно, ограничение прав)");
            }
            catch (Exception ex)
            {
                listView.Items.Add("Ошибка чтения реестра: " + ex.Message);
            }

            tab.Content = listView;
            return tab;
        }

        private void ReadUninstallKeys(RegistryKey root, string path, SortedSet<string> programs)
        {
            using (RegistryKey key = root.OpenSubKey(path))
            {
                if (key == null) return;

                foreach (string subKeyName in key.GetSubKeyNames())
                {
                    using (RegistryKey subKey = key.OpenSubKey(subKeyName))
                    {
                        string displayName = subKey?.GetValue("DisplayName") as string;
                        if (!string.IsNullOrEmpty(displayName))
                            programs.Add(displayName.Trim());
                    }
                }
            }
        }
    }
}
