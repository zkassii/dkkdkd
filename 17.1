<Window x:Class="FileManagerWPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Файловый менеджер" Height="600" Width="900"
        Loaded="Window_Loaded">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Меню -->
            <RowDefinition Height="Auto"/> <!-- Поле пути -->
            <RowDefinition Height="*"/>    <!-- Список файлов -->
        </Grid.RowDefinitions>

        <!-- Строка меню -->
        <Menu Grid.Row="0">
            <MenuItem Header="Файл">
                <MenuItem Header="Выход" Click="Exit_Click"/>
            </MenuItem>
        </Menu>

        <!-- Поле текущего каталога -->
        <DockPanel Grid.Row="1" Margin="5">
            <Button DockPanel.Dock="Right" Content="Перейти" Click="BtnGo_Click" Width="80"/>
            <TextBox x:Name="txtPath" Margin="0,0,5,0" KeyDown="TxtPath_KeyDown"/>
        </DockPanel>

        <!-- ListView с файлами -->
        <ListView x:Name="lvFiles" Grid.Row="2" Margin="5"
                  MouseDoubleClick="LvFiles_MouseDoubleClick"
                  SelectionMode="Extended">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="" Width="30">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <Image Source="{Binding Icon}" Width="24" Height="24"/>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="Имя" Width="300" DisplayMemberBinding="{Binding Name}"/>
                    <GridViewColumn Header="Дата изменения" Width="150" DisplayMemberBinding="{Binding LastWriteTime}"/>
                    <GridViewColumn Header="Размер" Width="100" DisplayMemberBinding="{Binding Size}"/>
                </GridView>
            </ListView.View>

            <!-- Контекстное меню -->
            <ListView.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="Копировать" Click="CtxCopy_Click"/>
                    <MenuItem Header="Вставить" Click="CtxPaste_Click"/>
                    <Separator/>
                    <MenuItem Header="Сжать в архив" Click="CtxCompress_Click"/>
                    <MenuItem Header="Извлечь из архива" Click="CtxExtract_Click"/>
                </ContextMenu>
            </ListView.ContextMenu>
        </ListView>
    </Grid>
</Window>
