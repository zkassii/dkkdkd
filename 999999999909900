### 4. Файл `main.py` (Основная программа)

```python
# main.py
# Основная программа — объединяет всё вместе

from author import Autor
from kniga_avtora import KnigaAvtora

def main():
    print("=== Задание 5.1 — Список авторов ===\n")
    
    N = int(input("Введите количество авторов (N): "))
    avtory = []

    for i in range(N):
        print(f"\n--- Автор {i+1} ---")
        fio = input("ФИО: ")
        strana = input("Страна: ")
        avtory.append(Autor(fio, strana))

    # Вывод всех авторов
    print("\n" + "="*50)
    print("СПИСОК ВСЕХ АВТОРОВ:")
    for avtor in avtory:
        avtor.info()

    # Только русские авторы
    print("\n" + "="*50)
    print("СПИСОК РУССКИХ АВТОРОВ:")
    for avtor in avtory:
        if avtor.strana.lower() in ["россия", "рф", "ru", "российская федерация"]:
            avtor.info()

    # Демонстрация KnigaAvtora
    print("\n" + "="*60)
    print("ДЕМОНСТРАЦИЯ КЛАССА КНИГААВТОРА")
    print("="*60)
    
    ka = KnigaAvtora("Пушкин Александр Сергеевич", "Россия", "Евгений Онегин")
    ka.dobavit_proizvedenie("Глава I")
    ka.dobavit_proizvedenie("Глава II")
    ka.dobavit_proizvedenie("Глава III")
    ka.polnaya_info()

    # Пример работы деструктора
    del ka


if __name__ == "__main__":
    main()
```

