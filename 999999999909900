### 2. Файл `book.py` (Задания 5.2, 5.3, 5.4)

```python
# book.py
# Задания 5.2 + 5.3 + 5.4 - Класс Книга

class Kniga:
    def __init__(self, nazvanie):
        """Конструктор"""
        self.__nazvanie = nazvanie           # приватное поле
        self.__soderzhanie = []              # изначально пустой список произведений
        print(f"Книга '{self.__nazvanie}' создана")

    def __del__(self):
        """Деструктор"""
        print(f"Книга '{self.__nazvanie}' удалена")

    def dobavit_proizvedenie(self, proizvedenie):
        """5.3 - Добавляет произведение в содержание"""
        self.__soderzhanie.append(proizvedenie)

    def kolichestvo_proizvedeniy(self):
        """5.3 - Возвращает количество произведений"""
        return len(self.__soderzhanie)

    def info(self):
        """5.4 - Вывод информации о книге"""
        print(f"Книга: {self.__nazvanie} Содержание:")
        if not self.__soderzhanie:
            print("  (содержание пустое)")
        else:
            for i, item in enumerate(self.__soderzhanie, 1):
                print(f"  {i}) {item}")


# ==================== ТЕСТ ====================
if __name__ == "__main__":
    print("=== Тест класса Книга ===")
    kniga = Kniga("Стихотворения")
    kniga.dobavit_proizvedenie("Я помню чудное мгновенье...")
    kniga.dobavit_proizvedenie("Зимний вечер")
    kniga.dobavit_proizvedenie("Пророк")
    
    kniga.info()
    print(f"Всего произведений: {kniga.kolichestvo_proizvedeniy()}")
```

