### 3. Файл `kniga_avtora.py` (Задание 5.5)

```python
# kniga_avtora.py
# Задание 5.5 - Класс КнигаАвтора (наследование от двух классов)

from author import Autor
from book import Kniga

class KnigaAvtora(Autor, Kniga):
    
    def __init__(self, fio, strana, nazvanie_knigi):
        Autor.__init__(self, fio, strana)      # инициализация от Автора
        Kniga.__init__(self, nazvanie_knigi)   # инициализация от Книги

    def polnaya_info(self):
        """Метод, выводящий полную информацию (автор + книга)"""
        print("=" * 60)
        print("ПОЛНАЯ ИНФОРМАЦИЯ О КНИГЕ АВТОРА")
        print("=" * 60)
        self.info()                    # info из класса Autor
        print("-" * 40)
        Kniga.info(self)               # info из класса Kniga
        print("=" * 60)


# ==================== ТЕСТ ====================
if __name__ == "__main__":
    print("=== Тест класса КнигаАвтора ===")
    ka = KnigaAvtora("Толстой Лев Николаевич", "Россия", "Война и мир")
    ka.dobavit_proizvedenie("Том 1. Часть первая")
    ka.dobavit_proizvedenie("Том 2. Часть вторая")
    ka.polnaya_info()
```

