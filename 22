import androidx.compose.ui.unit.dp
import kotlin.random.Random

@Composable
fun BadgeScreen() {
    var messageCount by remember { mutableStateOf(0) }
    val random = remember { Random }

    Column(
        modifier = Modifier
            .fillMaxSize()
            .background(Color.White),
        horizontalAlignment = Alignment.CenterHorizontally,
        verticalArrangement = Arrangement.Center
    ) {
        // BadgedBox с иконкой письма
        BadgedBox(
            badge = {
                if (messageCount > 0) {
                    Badge(
                        containerColor = Color(0xFFE91E63),   // розовый фон
                        contentColor = Color.White            // белый текст
                    ) {
                        Text(
                            text = messageCount.toString(),
                            style = MaterialTheme.typography.labelSmall
                        )
                    }
                }
            }
        ) {
            Icon(
                imageVector = Icons.Default.Email,
                contentDescription = "Сообщения",
                modifier = Modifier.size(72.dp),
                tint = Color(0xFF2196F3)
            )
        }

        Spacer(modifier = Modifier.height(48.dp))

        // Кнопка "Обновить"
        Button(
            onClick = {
                // Увеличиваем счётчик на случайное значение (1–5)
                messageCount += random.nextInt(1, 6)
            }
        ) {
            Text("Обновить")
        }

        Spacer(modifier = Modifier.height(24.dp))

        // Дополнительная информация
        Text(
            text = "Количество сообщений: $messageCount",
            style = MaterialTheme.typography.bodyMedium
        )
    }
}

