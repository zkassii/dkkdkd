import androidx.compose.foundation.background
import androidx.compose.foundation.layout.*
import androidx.compose.material3.*
import androidx.compose.runtime.*
import androidx.compose.ui.Alignment
import androidx.compose.ui.Modifier
import androidx.compose.ui.graphics.Color
import androidx.compose.ui.tooling.preview.Preview
import androidx.compose.ui.unit.dp
import kotlinx.coroutines.*

@Composable
fun CountdownScreen() {
    var timeLeft by remember { mutableStateOf(60) }     // секунды
    var isRunning by remember { mutableStateOf(false) }
    val scope = rememberCoroutineScope()

    // Прогресс от 1.0 до 0.0
    val progress = timeLeft / 60f

    // Изменение цвета в зависимости от оставшегося времени
    val indicatorColor = when {
        timeLeft >= 30 -> Color(0xFF4CAF50)     // зелёный
        timeLeft >= 10 -> Color(0xFFFFC107)     // жёлтый
        else -> Color(0xFFF44336)               // красный
    }

    Column(
        modifier = Modifier
            .fillMaxSize()
            .background(Color.White),
        horizontalAlignment = Alignment.CenterHorizontally,
        verticalArrangement = Arrangement.Center
    ) {
        Box(
            contentAlignment = Alignment.Center,
            modifier = Modifier.size(220.dp)
        ) {
            // Круговой индикатор с увеличенной толщиной
            CircularProgressIndicator(
                progress = { progress },
                color = indicatorColor,
                strokeWidth = 16.dp,           // увеличенная толщина полоски
                modifier = Modifier.size(200.dp)
            )

            // Отображение оставшегося времени
            Column(horizontalAlignment = Alignment.CenterHorizontally) {
                Text(
                    text = "$timeLeft",
                    style = MaterialTheme.typography.headlineLarge,
                    color = indicatorColor
                )
                Text(
                    text = "секунд",
                    style = MaterialTheme.typography.bodyMedium
                )
            }
        }

        Spacer(modifier = Modifier.height(48.dp))

        Button(
            onClick = {
                if (!isRunning) {
                    isRunning = true
                    timeLeft = 60

                    scope.launch {
                        while (timeLeft > 0) {
                            delay(1000)        // 1 секунда
                            timeLeft--
                        }
                        isRunning = false
                    }
                }
            },
            enabled = !isRunning
        ) {
            Text("Старт")
        }
    }
}

