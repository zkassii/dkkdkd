@Composable
fun SectionTitle(title: String) {
    Text(
        text = title,
        style = MaterialTheme.typography.headlineSmall,
        textAlign = TextAlign.Center,
        modifier = Modifier.fillMaxWidth()
    )
}

// ====================== 5.1 Animate*AsState ======================

@Composable
fun ColorTweenAnimation() {
    var isBlue by remember { mutableStateOf(false) }
    val color by animateColorAsState(
        targetValue = if (isBlue) Color.Blue else Color.Red,
        animationSpec = tween(durationMillis = 3000),
        label = "color tween"
    )

    Column(horizontalAlignment = Alignment.CenterHorizontally) {
        Text("Смена цвета (tween 3 секунды)")
        Box(
            modifier = Modifier
                .size(130.dp)
                .background(color)
                .clickable { isBlue = !isBlue }
        )
        Button(onClick = { isBlue = !isBlue }) {
            Text("Переключить цвет")
        }
    }
}

@Composable
fun ColorKeyframesAnimation() {
    var isActive by remember { mutableStateOf(false) }
    val color by animateColorAsState(
        targetValue = if (isActive) Color.Green else Color.Red,
        animationSpec = keyframes {
            durationMillis = 10000
            Color.Yellow at 2500
            Color.Blue at 5000
            Color.Magenta at 7500
        },
        label = "color keyframes"
    )

    Column(horizontalAlignment = Alignment.CenterHorizontally) {
        Text("Смена цвета (keyframes 10 секунд)")
        Box(
            modifier = Modifier
                .size(130.dp)
                .background(color)
                .clickable { isActive = !isActive }
        )
    }
}

@Composable
fun ImageSizeRepeatable() {
    var isBig by remember { mutableStateOf(false) }
    val size by animateDpAsState(
        targetValue = if (isBig) 200.dp else 100.dp,
        animationSpec = repeatable(
            iterations = 3,
            animation = tween(800),
            repeatMode = RepeatMode.Reverse
        ),
        label = "size repeatable"
    )

    Column(horizontalAlignment = Alignment.CenterHorizontally) {
        Text("Смена размера квадратной картинки (repeatable 3 раза)")
        Image(
            painter = painterResource(id = R.drawable.ic_square),
            contentDescription = null,
            modifier = Modifier.size(size)
        )
        Button(onClick = { isBig = !isBig }) {
            Text("Запустить анимацию")
        }
    }
}

@Composable
fun ImageSizeSpring() {
    var isBig by remember { mutableStateOf(false) }
    val size by animateDpAsState(
        targetValue = if (isBig) 180.dp else 80.dp,
        animationSpec = spring(
            dampingRatio = Spring.DampingRatioHighBouncy,
            stiffness = Spring.StiffnessLow
        ),
        label = "size spring"
    )

    Column(horizontalAlignment = Alignment.CenterHorizontally) {
        Text("Смена размера квадратной картинки (spring)")
        Image(
            painter = painterResource(id = R.drawable.ic_square),
            contentDescription = null,
            modifier = Modifier.size(size)
        )
        Button(onClick = { isBig = !isBig }) {
            Text("Запустить анимацию")
        }
    }
}

@Composable
fun InfiniteColorContainer() {
    val infiniteTransition = rememberInfiniteTransition(label = "infinite color")
    val color by infiniteTransition.animateColor(
        initialValue = Color.Red,
        targetValue = Color.Blue,
        animationSpec = infiniteRepeatable(
            animation = tween(1500, easing = LinearEasing),
            repeatMode = RepeatMode.Reverse
        ),
        label = "infinite color"
    )

    Column(horizontalAlignment = Alignment.CenterHorizontally) {
        Text("Бесконечная смена цвета контейнера")
        Box(
            modifier = Modifier
                .size(150.dp)
                .background(color)
        )
    }
}

// ====================== 5.2 Animatable ======================

@Composable
fun AnimatableColorChange() {
    val color = remember { Animatable(Color.Red) }
    val scope = rememberCoroutineScope()

    Column(horizontalAlignment = Alignment.CenterHorizontally) {
        Text("Animatable — смена цвета")
        Box(
            modifier = Modifier
                .size(130.dp)
                .background(color.value)
                .clickable {
                    scope.launch {
                        color.animateTo(if (color.value == Color.Red) Color.Cyan else Color.Red)
                    }
                }
        )
    }
}

@Composable
fun AnimatableImageSizeRepeatable() {
    val size = remember { Animatable(100f) }
    val scope = rememberCoroutineScope()

    Column(horizontalAlignment = Alignment.CenterHorizontally) {
        Text("Animatable — размер круглой картинки (3 раза)")
        Image(
            painter = painterResource(id = R.drawable.ic_circle),
            contentDescription = null,
            modifier = Modifier.size(size.value.dp)
        )
        Button(onClick = {
            scope.launch {
                size.animateTo(
                    targetValue = if (size.value > 120f) 100f else 180f,
                    animationSpec = repeatable(
                        iterations = 3,
                        animation = tween(600),
                        repeatMode = RepeatMode.Reverse
                    )
                )
            }
        }) {
            Text("Запустить анимацию")
        }
    }
}

@Composable
fun AnimatableImageRotation() {
    val rotation = remember { Animatable(0f) }
    val scope = rememberCoroutineScope()

    Column(horizontalAlignment = Alignment.CenterHorizontally) {
        Text("Animatable — поворот картинки на 360°")
        Image(
            painter = painterResource(id = R.drawable.ic_rect),
            contentDescription = null,
            modifier = Modifier
                .size(130.dp)
                .rotate(rotation.value)
        )
        Button(onClick = {
            scope.launch {
                rotation.animateTo(
                    targetValue = rotation.value + 360f,
                    animationSpec = tween(2000)
                )
            }
        }) {
            Text("Повернуть на 360°")
        }
    }
}

// ====================== 5.3 UpdateTransition ======================

enum class BoxState { Collapsed, Expanded }

@Composable
fun UpdateTransitionRectImage() {
    var currentState by remember { mutableStateOf(BoxState.Collapsed) }
    val transition = updateTransition(targetState = currentState, label = "rect transition")

    val width by transition.animateDp(label = "width") { state ->
        if (state == BoxState.Expanded) 300.dp else 100.dp
    }
    val height by transition.animateDp(label = "height") { state ->
        if (state == BoxState.Expanded) 600.dp else 200.dp
    }
    val rotation by transition.animateFloat(label = "rotation") { state ->
        if (state == BoxState.Expanded) 360f else 0f
    }

    Column(horizontalAlignment = Alignment.CenterHorizontally) {
        Text("UpdateTransition — размер и поворот прямоугольной картинки")
        Image(
            painter = painterResource(id = R.drawable.ic_rect),
            contentDescription = null,
            modifier = Modifier
                .size(width = width, height = height)
                .rotate(rotation)
        )
        Button(onClick = {
            currentState = if (currentState == BoxState.Collapsed)
                BoxState.Expanded else BoxState.Collapsed
        }) {
            Text(if (currentState == BoxState.Collapsed) "Развернуть" else "Вернуть")
        }
    }
}

// ====================== 5.4 InfiniteTransition ======================

@Composable
fun InfiniteFabAnimation() {
    val infiniteTransition = rememberInfiniteTransition(label = "fab scale")
    val scale by infiniteTransition.animateFloat(
        initialValue = 1f,
        targetValue = 1.3f,
        animationSpec = infiniteRepeatable(
            animation = tween(800, easing = FastOutSlowInEasing),
            repeatMode = RepeatMode.Reverse
        ),
        label = "fab scale"
    )

    Column(horizontalAlignment = Alignment.CenterHorizontally) {
        Text("InfiniteTransition — пульсация FloatingActionButton")
        FloatingActionButton(
            onClick = { },
            modifier = Modifier.scale(scale)
        ) {
            Icon(Icons.Default.Phone, contentDescription = "Звонок")
        }
    }
}

// ====================== 5.5 AnimatedVisibility ======================

@Composable
fun HamburgerMenuWithAnimatedItems() {
    var isMenuOpen by remember { mutableStateOf(false) }

    Column(horizontalAlignment = Alignment.CenterHorizontally) {
        IconButton(onClick = { isMenuOpen = !isMenuOpen }) {
            Icon(
                imageVector = if (isMenuOpen) Icons.Default.Close else Icons.Default.Menu,
                contentDescription = "Меню"
            )
        }

        Column {
            // Настройки
            AnimatedVisibility(
                visible = isMenuOpen,
                enter = slideInVertically(initialOffsetY = { -40 }) + fadeIn(),
                exit = slideOutVertically() + fadeOut()
            ) {
                Text("Настройки", fontSize = 20.sp, modifier = Modifier.padding(12.dp))
            }

            // Контакты
            AnimatedVisibility(
                visible = isMenuOpen,
                enter = scaleIn() + fadeIn(),
                exit = scaleOut() + fadeOut()
            ) {
                Text("Контакты", fontSize = 20.sp, modifier = Modifier.padding(12.dp))
            }

            // О программе
            AnimatedVisibility(
                visible = isMenuOpen,
                enter = expandVertically() + fadeIn(),
                exit = shrinkVertically() + fadeOut()
            ) {
                Text("О программе", fontSize = 20.sp, modifier = Modifier.padding(12.dp))
            }
        }
    }
}
