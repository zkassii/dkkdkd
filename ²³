using System;
using System.Drawing;
using System.Drawing.Imaging;
using System.IO;
using System.Threading;
using System.Threading.Tasks;

namespace Lab23_ImageInverter
{
    class Program
    {
        static void Main(string[] args)
        {
            Console.Write("Введите путь к папке с изображениями: ");
            string inputPath = Console.ReadLine();
            string outputPath = Path.Combine(inputPath, "Inverted_Images");

            if (!Directory.Exists(inputPath))
            {
                Console.WriteLine("Директория не найдена.");
                return;
            }

            if (!Directory.Exists(outputPath))
                Directory.CreateDirectory(outputPath);

            // Получаем только файлы формата jpg [по запросу пользователя]
            string[] files = Directory.GetFiles(inputPath, "*.jpg");
            int totalFiles = files.Length;
            int processedFiles = 0;

            if (totalFiles == 0)
            {
                Console.WriteLine("JPG файлы не найдены.");
                return;
            }

            Console.WriteLine($"Найдено файлов: {totalFiles}. Начинаю обработку...");

            [span_3](start_span)// Использование Parallel.ForEach для многопоточной обработки[span_3](end_span)
            Parallel.ForEach(files, filePath =>
            {
                InvertImage(filePath, outputPath);

                [span_4](start_span)// Потокобезопасное увеличение счетчика[span_4](end_span)
                int current = Interlocked.Increment(ref processedFiles);

                [span_5](start_span)// Синхронизация вывода прогресс-бара[span_5](end_span)
                lock (typeof(Program))
                {
                    DrawProgressBar(current, totalFiles);
                }
            });

            Console.WriteLine("\nОбработка завершена.");
        }

        static void InvertImage(string filePath, string outputDir)
        {
            [span_6](start_span)// Использование библиотеки System.Drawing.Common[span_6](end_span)
            using (Bitmap bitmap = new Bitmap(filePath))
            {
                for (int y = 0; y < bitmap.Height; y++)
                {
                    for (int x = 0; x < bitmap.X; x++) // В оригинальном коде была опечатка, правильно: bitmap.Width
                    {
                        Color oldColor = bitmap.GetPixel(x, y);
                        
                        [span_7](start_span)// Алгоритм инверсии: 255 - текущее значение[span_7](end_span)
                        Color invertedColor = Color.FromArgb(
                            255 - oldColor.R,
                            255 - oldColor.G,
                            255 - oldColor.B
                        );

                        [span_8](start_span)bitmap.SetPixel(x, y, invertedColor);[span_8](end_span)
                    }
                }
                string fileName = Path.GetFileName(filePath);
                bitmap.Save(Path.Combine(outputDir, fileName), ImageFormat.Jpeg);
            }
        }

        static void DrawProgressBar(int current, int total)
        {
            int percentage = (int)((double)current / total * 100);
            Console.SetCursorPosition(0, Console.CursorTop);
            Console.Write($"Прогресс: [{new string('#', percentage / 2)}{new string('-', 50 - percentage / 2)}] {percentage}%");
        }
    }
}
