using System;
using System.Drawing;
using System.Drawing.Imaging;
using System.IO;
using System.Linq;
using System.Threading;
using System.Threading.Tasks;

namespace ImageColorInverter
{
    class Program
    {
        static int processedCount = 0;
        static int totalCount = 0;
        static int errorCount = 0;
        static readonly object progressLock = new object();

        static void Main(string[] args)
        {
            Console.WriteLine("=== Лабораторная работа №23: Инвертация цветов изображений ===\n");

            Console.Write("Введите путь к папке с изображениями: ");
            string inputFolder = Console.ReadLine();

            if (!Directory.Exists(inputFolder))
            {
                Console.WriteLine("Ошибка: указанная папка не существует!");
                return;
            }

            string outputFolder = Path.Combine(Path.GetDirectoryName(inputFolder), "InvertedImages");
            Directory.CreateDirectory(outputFolder);

            // Получение всех изображений
            string[] imageExtensions = { "*.jpg", "*.jpeg", "*.png", "*.bmp", "*.gif" };
            var allFiles = imageExtensions
                .SelectMany(ext => Directory.GetFiles(inputFolder, ext, SearchOption.TopDirectoryOnly))
                .ToArray();

            // ПРЕДВАРИТЕЛЬНАЯ ПРОВЕРКА: отфильтровываем проблемные файлы
            var validFiles = allFiles.Where(file => IsValidImage(file)).ToArray();
            
            totalCount = validFiles.Length;
            int invalidCount = allFiles.Length - totalCount;

            if (totalCount == 0)
            {
                Console.WriteLine("Не найдено корректных изображений для обработки!");
                if (invalidCount > 0)
                    Console.WriteLine($"Обнаружено повреждённых файлов: {invalidCount}");
                return;
            }

            Console.WriteLine($"\nНайдено корректных изображений: {totalCount}");
            if (invalidCount > 0)
                Console.WriteLine($"Пропущено повреждённых файлов: {invalidCount}");
            
            Console.WriteLine("Начинается обработка...\n");

            var watch = System.Diagnostics.Stopwatch.StartNew();

            Parallel.ForEach(validFiles, new ParallelOptions { MaxDegreeOfParallelism = Environment.ProcessorCount }, imagePath =>
            {
                try
                {
                    InvertImageColors(imagePath, outputFolder);
                    Interlocked.Increment(ref processedCount);
                }
                catch (Exception ex)
                {
                    Interlocked.Increment(ref errorCount);
                    lock (progressLock)
                    {
                        Console.WriteLine($"\nОшибка при обработке {Path.GetFileName(imagePath)}: {ex.Message}");
                    }
                }
                finally
                {
                    lock (progressLock)
                    {
                        ShowProgressBar(processedCount + errorCount, totalCount);
                    }
                }
            });

            watch.Stop();
            Console.WriteLine($"\n\n=== Результат ===");
            Console.WriteLine($"✓ Успешно: {processedCount}");
            Console.WriteLine($"✗ Ошибок: {errorCount}");
            Console.WriteLine($"Время: {watch.Elapsed.Seconds} секунд");
        }

        /// <summary>
        /// Проверяет, является ли файл корректным изображением
        /// </summary>
        static bool IsValidImage(string filePath)
        {
            try
            {
                using (var bitmap = new Bitmap(filePath))
                {
                    return bitmap.Width > 0 && bitmap.Height > 0;
                }
            }
            catch
            {
                return false;
            }
        }

        static void InvertImageColors(string inputPath, string outputFolder)
        {
            using (var bitmap = new Bitmap(inputPath))
            {
                for (int y = 0; y < bitmap.Height; y++)
                {
                    for (int x = 0; x < bitmap.Width; x++)
                    {
                        Color pixel = bitmap.GetPixel(x, y);
                        bitmap.SetPixel(x, y, Color.FromArgb(
                            pixel.A,
                            255 - pixel.R,
                            255 - pixel.G,
                            255 - pixel.B
                        ));
                    }
                }

                string outputPath = Path.Combine(outputFolder, 
                    Path.GetFileNameWithoutExtension(inputPath) + "_inverted" + Path.GetExtension(inputPath));
                
                // Определяем формат сохранения
                string ext = Path.GetExtension(inputPath).ToLower();
                if (ext == ".jpg" || ext == ".jpeg")
                    bitmap.Save(outputPath, ImageFormat.Jpeg);
                else if (ext == ".png")
                    bitmap.Save(outputPath, ImageFormat.Png);
                else if (ext == ".bmp")
                    bitmap.Save(outputPath, ImageFormat.Bmp);
                else
                    bitmap.Save(outputPath, ImageFormat.Png);
            }
        }

        static void ShowProgressBar(int current, int total)
        {
            int barLength = 50;
            double percent = (double)current / total;
            int filledLength = (int)(barLength * percent);
            string progressBar = new string('█', filledLength) + new string('░', barLength - filledLength);
            Console.Write($"\rПрогресс: [{progressBar}] {current}/{total} ({percent * 100:F1}%)");
        }
    }
}
