using System;
using System.IO;
using System.Linq;
using System.Threading;
using System.Threading.Tasks;
using SixLabors.ImageSharp;
using SixLabors.ImageSharp.PixelFormats;

namespace ImageColorInverter
{
    class Program
    {
        static int processedCount = 0;
        static int totalCount = 0;
        static int errorCount = 0;
        static readonly object progressLock = new object();

        static void Main(string[] args)
        {
            Console.WriteLine("=== Лабораторная работа №23: Инвертация цветов ===\n");

            Console.Write("Введите путь к папке: ");
            string inputFolder = Console.ReadLine();

            if (!Directory.Exists(inputFolder))
            {
                Console.WriteLine("Папка не существует!");
                return;
            }

            string outputFolder = Path.Combine(inputFolder, "InvertedImages");
            Directory.CreateDirectory(outputFolder);

            // Все изображения
            string[] extensions = { "*.jpg", "*.jpeg", "*.png", "*.bmp", "*.gif" };
            var files = extensions
                .SelectMany(ext => Directory.GetFiles(inputFolder, ext))
                .ToArray();

            totalCount = files.Length;

            if (totalCount == 0)
            {
                Console.WriteLine("Нет изображений!");
                return;
            }

            Console.WriteLine($"Найдено: {totalCount} файлов\n");

            var watch = System.Diagnostics.Stopwatch.StartNew();

            // Многопоточная обработка
            Parallel.ForEach(files, new ParallelOptions { MaxDegreeOfParallelism = Environment.ProcessorCount }, filePath =>
            {
                try
                {
                    InvertImage(filePath, outputFolder);
                    Interlocked.Increment(ref processedCount);
                }
                catch (Exception ex)
                {
                    Interlocked.Increment(ref errorCount);
                    lock (progressLock)
                    {
                        Console.WriteLine($"\nОшибка: {Path.GetFileName(filePath)} - {ex.Message}");
                    }
                }
                finally
                {
                    lock (progressLock)
                    {
                        ShowProgress(processedCount + errorCount, totalCount);
                    }
                }
            });

            watch.Stop();
            Console.WriteLine($"\n\nГотово! Обработано: {processedCount}, Ошибок: {errorCount}");
            Console.WriteLine($"Время: {watch.Elapsed.Seconds} сек");
            Console.WriteLine($"Папка: {outputFolder}");
        }

        static void InvertImage(string inputPath, string outputFolder)
        {
            using (var image = Image.Load<Rgba32>(inputPath))
            {
                // Инвертируем каждый пиксель
                for (int y = 0; y < image.Height; y++)
                {
                    for (int x = 0; x < image.Width; x++)
                    {
                        var pixel = image[x, y];
                        image[x, y] = new Rgba32(
                            (byte)(255 - pixel.R),
                            (byte)(255 - pixel.G),
                            (byte)(255 - pixel.B),
                            pixel.A
                        );
                    }
                }

                string outputPath = Path.Combine(outputFolder, Path.GetFileName(inputPath));
                image.Save(outputPath);
            }
        }

        static void ShowProgress(int current, int total)
        {
            int barLen = 40;
            double percent = (double)current / total;
            int filled = (int)(barLen * percent);
            string bar = new string('=', filled) + new string('-', barLen - filled);
            Console.Write($"\r[{bar}] {current}/{total} ({percent * 100:F1}%)");
        }
    }
}
