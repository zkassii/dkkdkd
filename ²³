using System;
using System.Drawing;
using System.IO;
using System.Linq;
using System.Threading;
using System.Threading.Tasks;

class Program
{
    private static readonly object _lock = new object(); // Для синхронизации вывода в консоль

    static void Main(string[] args)
    {
        Console.WriteLine("=== Инвертор изображений (многопоточный) ===\n");

        Console.Write("Введите путь к папке с изображениями: ");
        string sourceFolder = Console.ReadLine()?.Trim();

        if (string.IsNullOrEmpty(sourceFolder) || !Directory.Exists(sourceFolder))
        {
            Console.WriteLine("Ошибка: указанная папка не существует!");
            return;
        }

        // Создаём папку для результата
        string outputFolder = Path.Combine(sourceFolder, "Inverted_Images");
        Directory.CreateDirectory(outputFolder);

        // Получаем все изображения
        string[] imageExtensions = { ".jpg", ".jpeg", ".png", ".bmp", ".gif", ".tiff" };
        var files = Directory.GetFiles(sourceFolder)
                             .Where(f => imageExtensions.Contains(Path.GetExtension(f).ToLower()))
                             .ToArray();

        if (files.Length == 0)
        {
            Console.WriteLine("В папке не найдено изображений!");
            return;
        }

        Console.WriteLine($"Найдено изображений: {files.Length}");
        Console.WriteLine($"Результат будет сохранён в: {outputFolder}\n");

        int processed = 0;           // Счётчик обработанных файлов
        int total = files.Length;

        // Многопоточная обработка
        Parallel.ForEach(files, file =>
        {
            try
            {
                string fileName = Path.GetFileName(file);
                string outputPath = Path.Combine(outputFolder, fileName);

                using (Bitmap bitmap = new Bitmap(file))
                {
                    InvertImageColors(bitmap);
                    bitmap.Save(outputPath);
                }

                // Увеличиваем счётчик потокобезопасно
                Interlocked.Increment(ref processed);

                // Показываем прогресс (синхронизировано)
                ShowProgress(processed, total, fileName);
            }
            catch (Exception ex)
            {
                lock (_lock)
                {
                    Console.WriteLine($"\nОшибка при обработке {Path.GetFileName(file)}: {ex.Message}");
                }
            }
        });

        Console.WriteLine("\n\nОбработка завершена! Все изображения инвертированы.");
        Console.ReadKey();
    }

    // Функция инверсии цветов
    static void InvertImageColors(Bitmap bitmap)
    {
        for (int x = 0; x < bitmap.Width; x++)
        {
            for (int y = 0; y < bitmap.Height; y++)
            {
                Color pixel = bitmap.GetPixel(x, y);
                Color inverted = Color.FromArgb(255 - pixel.R, 255 - pixel.G, 255 - pixel.B);
                bitmap.SetPixel(x, y, inverted);
            }
        }
    }

    // Вывод прогресс-бара
    static void ShowProgress(int processed, int total, string currentFile)
    {
        lock (_lock)
        {
            double percent = (double)processed / total * 100;
            int barWidth = 30;
            int filled = (int)(percent / 100 * barWidth);

            string bar = "[" + new string('█', filled) + new string('░', barWidth - filled) + "]";

            // Перезаписываем одну строку
            Console.Write($"\rОбработано: {processed}/{total} ({percent:F1}%) {bar}  | Сейчас: {currentFile}");
        }
    }
}
