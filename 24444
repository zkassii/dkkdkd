### 5.5 AnimatedVisibility с разными анимациями

```kotlin
@Composable
fun HamburgerMenuWithAnimatedItems() {
    var isMenuOpen by remember { mutableStateOf(false) }

    Column(horizontalAlignment = Alignment.CenterHorizontally) {
        IconButton(onClick = { isMenuOpen = !isMenuOpen }) {
            Icon(
                imageVector = if (isMenuOpen) Icons.Default.Close else Icons.Default.Menu,
                contentDescription = "Меню"
            )
        }

        AnimatedVisibility(
            visible = isMenuOpen,
            enter = fadeIn() + slideInHorizontally(),
            exit = fadeOut() + slideOutHorizontally()
        ) {
            Column {
                // Настройки — slide + fade
                AnimatedVisibility(
                    visible = isMenuOpen,
                    enter = slideInVertically(initialOffsetY = { -40 }) + fadeIn(),
                    exit = slideOutVertically() + fadeOut()
                ) {
                    Text("Настройки", fontSize = 20.sp, modifier = Modifier.padding(8.dp))
                }

                // Контакты — scale
                AnimatedVisibility(
                    visible = isMenuOpen,
                    enter = scaleIn() + fadeIn(),
                    exit = scaleOut() + fadeOut()
                ) {
                    Text("Контакты", fontSize = 20.sp, modifier = Modifier.padding(8.dp))
                }

                // О программе — expand
                AnimatedVisibility(
                    visible = isMenuOpen,
                    enter = expandVertically() + fadeIn(),
                    exit = shrinkVertically() + fadeOut()
                ) {
                    Text("О программе", fontSize = 20.sp, modifier = Modifier.padding(8.dp))
                }
            }
        }
    }
}
