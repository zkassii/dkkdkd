### 5.2 Animatable

```kotlin
@Composable
fun AnimatableColorChange() {
    val color = remember { Animatable(Color.Red) }
    val scope = rememberCoroutineScope()

    Column(horizontalAlignment = Alignment.CenterHorizontally) {
        Text("Animatable — смена цвета")
        Box(
            modifier = Modifier
                .size(120.dp)
                .background(color.value)
                .clickable {
                    scope.launch {
                        color.animateTo(if (color.value == Color.Red) Color.Cyan else Color.Red)
                    }
                }
        )
    }
}

@Composable
fun AnimatableImageSizeRepeatable() {
    val size = remember { Animatable(100f) }
    val scope = rememberCoroutineScope()

    Column(horizontalAlignment = Alignment.CenterHorizontally) {
        Text("Animatable — размер круглой картинки (3 раза)")
        Image(
            painter = painterResource(id = R.drawable.ic_circle),
            contentDescription = null,
            modifier = Modifier.size(size.value.dp)
        )
        Button(onClick = {
            scope.launch {
                size.animateTo(
                    targetValue = if (size.value > 120f) 100f else 180f,
                    animationSpec = repeatable(
                        iterations = 3,
                        animation = tween(600),
                        repeatMode = RepeatMode.Reverse
                    )
                )
            }
        }) {
            Text("Запустить анимацию размера")
        }
    }
}

@Composable
fun AnimatableImageRotation() {
    val rotation = remember { Animatable(0f) }
    val scope = rememberCoroutineScope()

    Column(horizontalAlignment = Alignment.CenterHorizontally) {
        Text("Animatable — поворот картинки на 360°")
        Image(
            painter = painterResource(id = R.drawable.ic_rect),
            contentDescription = null,
            modifier = Modifier
                .size(120.dp)
                .rotate(rotation.value)
        )
        Button(onClick = {
            scope.launch {
                rotation.animateTo(
                    targetValue = rotation.value + 360f,
                    animationSpec = tween(2000)
                )
            }
        }) {
            Text("Повернуть на 360°")
        }
    }
}
